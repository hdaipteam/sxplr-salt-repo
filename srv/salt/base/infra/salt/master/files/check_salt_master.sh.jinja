#!/usr/bin/env bash
# srv/salt/base/infra/salt/master/files/check_salt_master.sh.jinja
# Managed by Salt - DO NOT EDIT MANUALLY
#
# Einfaches HA-Healthcheck-Script für Salt-Master (MNGM-001 / MNGM-002)
# - liest alle Entscheidungen aus dem Grain "sxplr_master"
# - ha_role: single    -> kein HA, Master bleibt wie er ist
#            primary   -> Master MUSS laufen
#            secondary -> Master DARF nur laufen, wenn Peer nicht erreichbar ist
#
# Flags:
#   --dry-run / -n   : nur loggen, keine systemctl-Aktionen
#   --verbose / -v   : ausführlichere Logs (mehrfach möglich)

set -euo pipefail

DRY_RUN=0
VERBOSE=0

# Optionaler Vault-Health-Check (nur HTTP /sys/health, keine Secrets!)
VAULT_ADDR="${VAULT_ADDR:-http://10.99.0.1:8200}"
VAULT_TIMEOUT="${VAULT_TIMEOUT:-2}"
CHECK_VAULT="${CHECK_VAULT:-1}"  # 1 = prüfen, 0 = ignorieren

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run)
      DRY_RUN=1
      shift
      ;;
    -v|--verbose)
      VERBOSE=$((VERBOSE + 1))
      shift
      ;;
    *)
      # unbekannte Flags ignorieren, damit systemd nicht stolpert
      shift
      ;;
  esac
done

log() {
  local level="$1"; shift
  local msg="$*"
  # in Journal und optional auf STDOUT
  logger -t salt-master-ha "[$level] $msg" || true
  if [[ "$VERBOSE" -gt 0 ]]; then
    echo "[$(date -Is)] [$level] $msg"
  fi
}

check_vault() {
  if [[ "${CHECK_VAULT}" -ne 1 ]]; then
    return 0
  fi

  if curl -s --max-time "${VAULT_TIMEOUT}" "${VAULT_ADDR}/v1/sys/health" >/dev/null 2>&1; then
    log "DEBUG" "Vault reachable at ${VAULT_ADDR}"
    return 0
  else
    log "ERROR" "Vault at ${VAULT_ADDR} not reachable"
    return 1
  fi
}

# ----------------------------------------------------------
# 1. sxplr_master-Grain holen und auflösen
# ----------------------------------------------------------

# Immer die Salt-Config aus /etc/salt verwenden.
RAW_JSON="$(
  salt-call --local -c /etc/salt --out=json grains.item sxplr_master 2>/dev/null || true
)"

if [[ -z "${RAW_JSON}" ]]; then
  log "WARN" "sxplr_master-Grain nicht gefunden (leerer JSON-Output) - keine HA-Entscheidung möglich, exit 0."
  exit 0
fi

parse_grains() {
  python3 << 'PY' <<< "${RAW_JSON}"
import json, sys

try:
    data = json.load(sys.stdin)
except Exception:
    # Fallback auf Standalone-Modus
    print("single")
    print("")
    print("")
    print("")
    sys.exit(0)

if not isinstance(data, dict) or not data:
    print("single")
    print("")
    print("")
    print("")
    sys.exit(0)

# Top-Level-Key ist bei salt-call typischerweise "local",
# wir nehmen generisch einfach den ersten.
top_key = next(iter(data.keys()))
root = data.get(top_key, {}) or {}

# Verschiedene mögliche Strukturen abdecken:
# 1) {"local": {"sxplr_master": {...}}}
# 2) {"local": {"return": {"sxplr_master": {...}}}}
sx = {}

if isinstance(root, dict):
    if "sxplr_master" in root:
        sx = root.get("sxplr_master") or {}
    elif "return" in root and isinstance(root["return"], dict):
        sx = root["return"].get("sxplr_master") or {}

if not sx:
    # Kein sinnvolles sxplr_master gefunden -> Standalone
    print("single")
    print("")
    print("")
    print("")
    sys.exit(0)

role = sx.get("role", {}) or {}
mngm = sx.get("mngm", {}) or {}
sm   = sx.get("salt_master", {}) or {}

ha_role    = str(role.get("ha_role", "single"))
node_id    = str(mngm.get("node_id", ""))
wg_ip      = str(sm.get("wg_ip", ""))
peer_wg_ip = str(sm.get("ha_peer_wg_ip", ""))

print(ha_role)
print(node_id)
print(wg_ip)
print(peer_wg_ip)
PY
}

mapfile -t _vals < <(parse_grains)

HA_ROLE="${_vals[0]:-single}"
NODE_ID="${_vals[1]:-}"
WG_IP="${_vals[2]:-}"
PEER_WG_IP="${_vals[3]:-}"

log "DEBUG" "sxplr_master: ha_role='${HA_ROLE}', node_id='${NODE_ID}', wg_ip='${WG_IP}', peer_wg_ip='${PEER_WG_IP}'"

# ----------------------------------------------------------
# 2. kleine Helfer für systemctl
# ----------------------------------------------------------

is_master_active() {
  systemctl is-active --quiet salt-master
}

start_master() {
  if is_master_active; then
    log "INFO" "salt-master läuft bereits - kein start nötig."
    return 0
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "INFO" "DRY-RUN: würde 'systemctl start salt-master' ausführen."
  else
    log "INFO" "Starte salt-master (Failover / Sicherstellung aktivem Master)…"
    if ! systemctl start salt-master; then
      log "ERROR" "Konnte salt-master nicht starten!"
      return 1
    fi
  fi
}

stop_master() {
  if ! is_master_active; then
    log "INFO" "salt-master ist bereits gestoppt - kein stop nötig."
    return 0
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    log "INFO" "DRY-RUN: würde 'systemctl stop salt-master' ausführen."
  else
    log "WARN" "Stoppe salt-master (Peer gilt als aktiv)…"
    if ! systemctl stop salt-master; then
      log "ERROR" "Konnte salt-master nicht stoppen!"
      return 1
    fi
  fi
}

peer_reachable() {
  local ip="$1"
  if [[ -z "${ip}" ]]; then
    # Ohne Peer-IP können wir keine Aussage treffen
    return 1
  fi
  ping -c1 -W1 "${ip}" >/dev/null 2>&1
}

# ----------------------------------------------------------
# 3. HA-Entscheidung
# ----------------------------------------------------------

case "${HA_ROLE}" in
  single|"")
    # Kein HA - Knoten verhält sich "standalone"
    log "INFO" "ha_role='${HA_ROLE}' -> Standalone-Modus, keine HA-Aktion."
    exit 0
    ;;
  primary)
    # Optional: Primary soll bestenfalls nur aktiv sein, wenn Vault erreichbar ist
    if ! check_vault; then
      log "WARN" "ha_role='primary', aber Vault ist NICHT erreichbar - lasse salt-master weiterlaufen, aber markiere Health als kritisch."
      # Kein stop_master() hier, damit im Worst-Case wenigstens ein Master da ist.
    fi

    if is_master_active; then
      log "INFO" "ha_role='primary' und salt-master läuft - OK."
    else
      log "WARN" "ha_role='primary', aber salt-master läuft NICHT - versuche zu starten…"
      start_master
    fi
    ;;
  secondary)
    # Secondary DARF nur laufen, wenn der Peer NICHT erreichbar ist UND Vault funktioniert
    if peer_reachable "${PEER_WG_IP}"; then
      log "INFO" "ha_role='secondary' und Peer (${PEER_WG_IP}) ist erreichbar - secondary bleibt PASSIV."
      stop_master
    else
      if ! check_vault; then
        log "ERROR" "ha_role='secondary', Peer nicht erreichbar, aber Vault ebenfalls nicht erreichbar - übernehme NICHT aktiv."
        stop_master
        exit 1
      fi
      log "WARN" "ha_role='secondary' und Peer (${PEER_WG_IP}) ist NICHT erreichbar - secondary übernimmt AKTIV."
      start_master
    fi
    ;;
  *)
    # Unbekannte Rolle -> defensiv verhalten, nichts machen
    log "WARN" "Unbekannte ha_role='${HA_ROLE}' - keine HA-Aktion."
    ;;
esac

exit 0
